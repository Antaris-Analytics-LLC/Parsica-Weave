{
  "description": "Parsica Weave continuity capture and rehydration hooks.",
  "hooks": {
    "Stop":            [{ "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/weave-run.sh\" Stop", "timeout": 10 }] }],
    "UserPromptSubmit":[{ "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/weave-run.sh\" UserPromptSubmit", "timeout": 10 }] }],
    "SessionStart":    [{ "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/weave-run.sh\" SessionStart", "timeout": 10 }] }],
    "PreCompact":      [{ "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/weave-run.sh\" PreCompact", "timeout": 10 }] }],
    "PostToolUse":     [{ "matcher": "Grep", "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/weave-run.sh\" PostToolUse", "timeout": 10 }] }]
  }
}
